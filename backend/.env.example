# Groq (RAG generator)
GROQ_API_KEY=

# Database (defaults to SQLite)
DATABASE_URL=sqlite:///./eureka.db

# ChromaDB storage
CHROMADB_PATH=./chromadb

# Upload dir
UPLOAD_DIR=./uploads

# Use local HF generator for discovery/keywords (True/False)
HF_USE_LOCAL_GENERATOR=True

# Optional: HF API Token if you want to use HF Inference API
HF_API_TOKEN=
