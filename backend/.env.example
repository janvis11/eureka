APP_NAME=Eureka AI
DEBUG=false
SECRET_KEY=
ALGORITHM=HS256

DATABASE_URL=sqlite:///./eureka.db
MODEL_PROVIDER=auto

# Default provider is NVIDIA NIM (Nemotron). Get a free API key at
# https://build.nvidia.com. auto-detection checks NVIDIA_API_KEY first, so
# leaving GROQ_API_KEY/OPENAI_API_KEY set alongside it is a safe fallback,
# not a conflict.
GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIM=2048

NVIDIA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

UPLOAD_DIR=
MAX_UPLOAD_SIZE=104857600
CHROMADB_PATH=./chromadb
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_GAPS=15
MAX_HYPOTHESES_PER_RUN=25
TREND_WINDOW_DAYS=365
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
ALLOWED_ORIGINS=*
ALLOWED_HOSTS=*

