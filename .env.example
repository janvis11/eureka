APP_NAME=Eureka AI
DEBUG=false
SECRET_KEY=
ALGORITHM=HS256

DATABASE_URL=
MODEL_PROVIDER=auto

# Default provider is NVIDIA NIM (Nemotron). Get a free API key at
# https://build.nvidia.com.
GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b

# Embedding model
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIM=2048

# Provider API Keys (auto-detection checks NVIDIA_API_KEY first, then falls
# back to GROQ_API_KEY/OPENAI_API_KEY if set)
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible endpoints
OPENAI_BASE_URL=
EMBEDDING_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

UPLOAD_DIR=
MAX_UPLOAD_SIZE=104857600
CHROMADB_PATH=./chromadb
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_GAPS=15
MAX_HYPOTHESES_PER_RUN=25
TREND_WINDOW_DAYS=365
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
ALLOWED_ORIGINS=*
ALLOWED_HOSTS=*
VITE_API_BASE_URL=http://localhost:8000/api

